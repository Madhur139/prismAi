# Copy this file to .env and fill in the values.
#   cp prism-backend/.env.example prism-backend/.env

# ---- required ----
# Where the database lives.
MONGO_URI=mongodb://127.0.0.1:27017/prism-ai
# Used to sign the login tokens. Make it long and random.
JWT_SECRET=change-me-to-something-long-and-random
# Your Google AI Studio key.
GEMINI_API_KEY=your-gemini-key

# ---- server ----
PORT=8080
# Which website may call this API ("*" allows all).
CLIENT_ORIGIN=*

# ---- images (optional but recommended) ----
# Cloudinary hosts the pictures you upload. Without CLOUDINARY_CLOUD_NAME the
# app still works: pictures are saved on the server itself and served from
# /uploads. With it, they are stored on Cloudinary's CDN instead.
# Get the three values from https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ---- Google web search (optional) ----
# With these, Prism AI searches Google first and uses the snippets.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
